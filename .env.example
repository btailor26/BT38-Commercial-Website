# Copy to .env locally; set deployment secrets through your hosting provider.
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
LOCAL_DATA_DIR=.data
# Existing dedicated website database only; never use the inventory neondb URL.
WEBSITE_DATABASE_URL=
WEBSITE_IMPORT_ENABLED=false
ADMIN_EMAIL=
CUSTOMER_AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
# Generate a new independent key with: openssl rand -hex 32
GOOGLE_SESSION_SIGNING_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CHECKOUT_ENABLED=false
REVOLUT_SANDBOX=false
REVOLUT_PRODUCTION_API_SECRET_KEY=
REVOLUT_MERCHANT_API_VERSION=
REVOLUT_WEBHOOK_SIGNING_SECRET=
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_COMPANY_NUMBER=
INVOICE_CONTACT_EMAIL=
INVOICE_VAT_NUMBER=
BILLING_COUNTRY_TAX_JSON={}
# Private supporting documents. Sites reuses its existing private R2 binding.
# Independent Node deployments use a PRIVATE S3-compatible bucket (including R2).
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_BUCKET=
PRIVATE_S3_ACCESS_KEY_ID=
PRIVATE_S3_SECRET_ACCESS_KEY=
PRIVATE_S3_REGION=auto
PARTNER_UPLOAD_MAX_BYTES=10485760
PARTNER_UPLOAD_MAX_FILES=5
PARTNER_DOCUMENT_RETENTION_DAYS=180
REJECTED_DOCUMENT_RETENTION_DAYS=30
# Optional dedicated signing key; otherwise derives a document-purpose key from Google session signing.
UPLOAD_DOWNLOAD_SIGNING_KEY=
# Trusted HTTPS binary scanner gateway returning {"status":"clean"|"infected","engine":"..."}.
# PDF/Office/RTF remain quarantined until a scanner reports clean.
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TOKEN=

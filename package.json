    "prebuild": "node scripts/build-public-frontend.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "aws4fetch": "^1.0.20",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }

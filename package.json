{
  "name": "bt38-commercial-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "validate": "node --check dist/server/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env runtime/server.js",
    "start": "node --env-file-if-exists=.env runtime/server.js",
    "test": "node scripts/test.mjs",
    "build:sites": "bash scripts/build.sh",
    "test:ui": "node scripts/check-partner-ui.mjs",
